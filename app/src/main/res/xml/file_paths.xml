<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Only the folder the camera writes a just-taken photo into. -->
    <cache-path name="capture" path="capture/" />
    <!-- Short-lived plain copies of a made file, for the app the owner opens or shares it with. Erased soon after. The stored files themselves are locked and never exposed. -->
    <cache-path name="exports" path="exports/" />
</paths>
