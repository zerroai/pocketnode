<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/network_security_config">
        <!-- Debug builds only: lets the emulator reach a model server on the dev machine over http, and lets a developer start a chat with adb. -->
        <receiver android:name=".DebugReceiver" android:exported="true">
            <intent-filter>
                <action android:name="com.pocketnode.app.DEBUG_SEND" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
